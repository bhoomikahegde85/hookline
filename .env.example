# Copy to .env (git-ignored) and fill in. Never commit real tokens.
# Optional: Gemini explains the TTCC drop-off segments (docs/gemini.md). THE VIDEO IS UPLOADED TO GOOGLE. Use a NEW key: never reuse one that was ever committed.
GEMINI_API_KEY=
# Optional: a Flash model your key can use (default: gemini-3.8-flash)
GEMINI_MODEL=
# Optional: TRIBE v2 on your own Hugging Face Inference Endpoint (docs/tribe.md)
TRIBE_ENDPOINT_URL=
HF_TOKEN=
# Optional: TTCC retention model in your own Hugging Face Space (docs/ttcc.md)
TTCC_ENDPOINT_URL=
